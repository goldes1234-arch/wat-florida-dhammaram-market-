APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost/ProjectWFD/Temple_Market

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=temple_market
DB_USERNAME=root
DB_PASSWORD=
DB_SOCKET=/Applications/XAMPP/xamppfiles/var/mysql/mysql.sock

MAIL_FROM_ADDRESS=no-reply@templemarket.local
MAIL_FROM_NAME="Temple Market"

# Absolute path to the mysqldump binary (leave blank to try "mysqldump" on PATH)
MYSQLDUMP_PATH=
# How many recent backups to keep before older ones are auto-deleted
BACKUP_RETENTION=14
# Random secret required by GET /cron/backup?token=... so hosting's cron can trigger
# a backup without a login session. Generate with: php -r "echo bin2hex(random_bytes(24));"
BACKUP_CRON_SECRET=
