# local | staging | production — "staging" additionally forces Stripe to test-mode-only
# keys and blocks real outbound email, see README's "Staging environment" section
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost/ProjectWFD/Temple_Market

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=temple_market
DB_USERNAME=root
DB_PASSWORD=
DB_SOCKET=/Applications/XAMPP/xamppfiles/var/mysql/mysql.sock

MAIL_FROM_ADDRESS=no-reply@templemarket.local
MAIL_FROM_NAME="Temple Market"

# Absolute path to the mysqldump binary (leave blank to try "mysqldump" on PATH)
MYSQLDUMP_PATH=
# Absolute path to the mysql client binary, used by the admin "Restore" action
# (leave blank to try "mysql" on PATH)
MYSQL_PATH=
# How many recent backups to keep before older ones are auto-deleted
BACKUP_RETENTION=14
# Random secret required by GET /cron/backup?token=... so hosting's cron can trigger
# a backup without a login session. Generate with: php -r "echo bin2hex(random_bytes(24));"
# Also required by GET /cron/post-deploy?token=... (same secret) — wire that URL into
# your host's "run after deploy" action so pending database/upgrades/*.sql files apply
# automatically and PHP's OPcache clears on every deploy, instead of by hand.
BACKUP_CRON_SECRET=
